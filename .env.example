# Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Zoom Server-to-Server OAuth App (usadas apenas nas funções serverless em /api, NUNCA no frontend)
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
# ID ou e-mail do usuário Zoom em cuja agenda as reuniões serão criadas (geralmente "me")
ZOOM_USER_ID=me

# Usado pelas funções serverless para validar a sessão do Supabase (Settings > API > service_role)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
